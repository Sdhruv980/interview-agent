# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/interview-agent?retryWrites=true&w=majority

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── LLM ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...   # uncomment to use Claude instead

# ── Client ────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ── File Storage (optional for MVP) ───────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
